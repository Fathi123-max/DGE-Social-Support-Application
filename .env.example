# ===========================================
# DGE Social Support Application
# Environment Variables Configuration
# ===========================================

# AI Configuration
# -----------------
# API Key for AI service (Minimax or OpenAI)
EXPO_PUBLIC_OPENAI_API_KEY=your_api_key_here

# API URL for AI service
# Use one of the following:
#   - Minimax: https://api.minimax.io/v1/chat/completions
#   - OpenAI:  https://api.openai.com/v1/chat/completions
EXPO_PUBLIC_OPENAI_API_URL=https://api.minimax.io/v1/chat/completions

# AI Model to use
# Use one of the following:
#   - Minimax: MiniMax-M2.1
#   - OpenAI:  gpt-4o, gpt-4o-mini, etc.
EXPO_PUBLIC_OPENAI_API_MODEL=MiniMax-M2.1